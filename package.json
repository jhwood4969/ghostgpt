{
  "name": "ghostgpt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,ai -c cyan,magenta \"vite\" \"tsx server/index.ts\"",
    "dev:web": "vite",
    "dev:ai": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "concurrently -k -n web,ai -c cyan,magenta \"vite preview\" \"tsx server/index.ts\"",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "concurrently": "^10.0.7",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "description": "GhostGPT.live — multi-model AI chat and OpenAI-compatible API platform"
}
